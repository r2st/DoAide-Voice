# DoAide Voice — environment configuration
# Copy to .env and fill in real values for deployment.

ENVIRONMENT=development
DEBUG=true

# Database
DATABASE_URL=postgresql+psycopg://voicebot:voicebot@localhost:5432/voicebot

# JWT
JWT_SECRET=change-me-to-a-long-random-string

# CORS
BACKEND_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI (OpenRouter — free models)
OPENROUTER_API_KEY=

# AI (Gemini)
GEMINI_API_KEY=

# File uploads
UPLOAD_DIR=./data/knowledge
